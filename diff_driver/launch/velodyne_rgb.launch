<launch>
  <!-- <param name="use_sim_time" value="true" /> -->
  <!-- 使用 static_transform_publisher 发布从 rslidar 到 rgb_camera_link 的静态坐标变换 -->
  <!-- <node pkg="tf" type="static_transform_publisher" name="rsldiar_to_camera_base" 
    args="0.0791 0.0016 -0.1507 0 0 0 1 rslidar camera_base 100" />  -->

  <node pkg="tf" type="static_transform_publisher" name="rslidar_to_rgb_camera_link" 
      args="0.0791 -0.0147 -0.1507 -0.51280493  0.50297126 -0.48930779  0.49459974 rslidar rgb_camera_link 100" />
</launch>
